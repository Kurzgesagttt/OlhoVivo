# ============================================================
# Variaveis de ambiente - EXEMPLO
#
# Para rodar localmente com Docker Compose:
#   cp .env.localexample .env.local
#   docker compose -f docker/docker-compose.yml up --build
#
# NUNCA commite .env.local ou .env.production com valores reais.
# ============================================================

# ------------------------------------------------------------
# Banco de dados
# Local: o Docker Compose sobe o PostgreSQL com estas credenciais.
# Producao: substitua por Supabase, RDS ou outro host externo.
# ------------------------------------------------------------
DB_NAME=olhovivo_db
DB_USER=olhovivo_user
DB_PASSWORD=TROQUE_ESTA_SENHA_LOCAL

# Variaveis usadas diretamente pela imagem oficial do PostgreSQL.
# Em ambiente local, mantenha estes valores iguais aos equivalentes acima.
POSTGRES_DB=olhovivo_db
POSTGRES_USER=olhovivo_user
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA_LOCAL

# Local: usado pelo backend dentro da rede Docker.
# Producao: substitua por Supabase, RDS ou outro host externo.
DB_URL=jdbc:postgresql://db:5432/olhovivo_db

# ------------------------------------------------------------
# Banco Supabase / Producao
#
# Copie estes valores para .env.production e preencha com os dados
# do Supabase. Nao use estes placeholders em ambiente real.
# ------------------------------------------------------------
# Para Docker/local, prefira a connection string "Session pooler" do Supabase.
# DB_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.PROJECT_REF
# DB_PASSWORD=SENHA_DO_BANCO_SUPABASE

# ------------------------------------------------------------
# JWT (HS512) - gere com:
#   openssl rand -hex 64
# Deve ter no minimo 64 bytes (128 caracteres hex).
# ------------------------------------------------------------
JWT_SECRET=COLE_AQUI_O_SEGREDO_JWT_MINIMO_128_CHARS_HEX
PRIVACY_POLICY_VERSION=v1

# ------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
