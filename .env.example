# ============================================================
# Variáveis de ambiente — EXEMPLO. Copie para .env.local ou .env.production
# NUNCA commite o arquivo com valores reais.
# ============================================================

# Banco de dados (local: PostgreSQL no Docker)
DB_NAME=olhodobairro
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_AQUI

# Banco de dados (produção: aponte para Supabase ou RDS)
# DB_URL=jdbc:postgresql://SEU_HOST:5432/SEU_BANCO

# JWT — gere um segredo de no mínimo 64 bytes aleatórios (HS512)
JWT_SECRET=SEU_SEGREDO_JWT_AQUI_MINIMO_64_BYTES

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
