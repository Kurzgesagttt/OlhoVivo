# ============================================================
# Variaveis de ambiente - PRODUCAO / SUPABASE
#
# Para usar:
#   cp .env.production.example .env.production
#   docker compose -f docker/docker-compose.prod.yml up --build
#
# NUNCA commite .env.production com valores reais.
# ============================================================

# ------------------------------------------------------------
# Banco de dados Supabase
#
# No Supabase, prefira a connection string "Session pooler" para
# rodar via Docker/local, porque ela funciona em redes IPv4.
# Mantenha sslmode=require.
# ------------------------------------------------------------
DB_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=SENHA_DO_BANCO_SUPABASE

# ------------------------------------------------------------
# JWT (HS512)
#
# Gere com:
#   openssl rand -hex 64
# ------------------------------------------------------------
JWT_SECRET=COLE_AQUI_O_SEGREDO_JWT_MINIMO_128_CHARS_HEX
PRIVACY_POLICY_VERSION=v1

# ------------------------------------------------------------
# Frontend
# Em deploy local pelo nginx do Docker, use /api/v1.
# ------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
