# ============================================================
# Variáveis de ambiente — EXEMPLO
#
# Para rodar localmente com Docker Compose:
#   cp .env.example .env.local
#   docker compose -f docker/docker-compose.yml up --build
#
# NUNCA commite .env.local ou .env.production com valores reais.
# ============================================================

# ------------------------------------------------------------
# Banco de dados
# Local: o Docker Compose sobe o PostgreSQL com estas credenciais.
# Produção: substitua por Supabase, RDS ou outro host externo.
# ------------------------------------------------------------
DB_NAME=olhovivo_db
DB_USER=olhovivo_user
DB_PASSWORD=TROQUE_ESTA_SENHA_LOCAL

# Produção — URL JDBC completa (ignorado no docker-compose.yml local)
DB_URL=jdbc:postgresql://SEU_HOST:5432/${DB_NAME}

# ------------------------------------------------------------
# JWT (HS512) — gere com:
#   openssl rand -hex 64
# Deve ter no mínimo 64 bytes (128 caracteres hex).
# ------------------------------------------------------------
JWT_SECRET=COLE_AQUI_O_SEGREDO_JWT_MINIMO_128_CHARS_HEX

# ------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
